# ============ DeepSeek（默认大模型，OpenAI 兼容协议） ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# auto: 有 key 就调用，没有/失败自动回退到本地模板；off: 强制离线；on: 强制调用
ALGOVIZ_AI_MODE=auto

# ============ 语音合成 ============
# edge: 微软 Edge TTS（免费、需联网）；sapi: Windows 本地语音；silent: 静音视频
ALGOVIZ_TTS_PROVIDER=edge
ALGOVIZ_VOICE=zh-CN-XiaoxiaoNeural
ALGOVIZ_TTS_RATE=+0%

# ============ 渲染与输出 ============
ALGOVIZ_OUTPUT=output
ALGOVIZ_RESOLUTION=1920x1080
ALGOVIZ_FPS=30
ALGOVIZ_THEME=dark
# 单任务最长时长（秒），超出会压缩步骤节奏
ALGOVIZ_MAX_SECONDS=240
# 批量并发数（Manim 渲染比较吃 CPU，建议 2~3）
ALGOVIZ_WORKERS=2
ALGOVIZ_RETRIES=1
# Manim 渲染画质：high=正式 1920x1080；medium=1280x720；low=854x480（调试用）
ALGOVIZ_RENDER_QUALITY=high
