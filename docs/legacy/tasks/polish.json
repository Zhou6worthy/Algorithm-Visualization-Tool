{
  "batch_name": "demo_polish",
  "defaults": {
    "render_quality": "high",
    "tts": true,
    "theme": "dark",
    "steps_per_segment": 4
  },
  "tasks": [
    {
      "id": "polish-bubble",
      "algorithm": "bubble_sort",
      "title": "冒泡排序：相邻交换",
      "params": { "array": [5, 3, 8, 1, 9, 2] }
    },
    {
      "id": "polish-binary",
      "algorithm": "binary_search",
      "title": "二分查找：每次排除一半",
      "params": { "array": [1, 3, 5, 7, 9, 11, 13], "target": 7 }
    },
    {
      "id": "polish-inorder",
      "algorithm": "tree_inorder",
      "title": "二叉搜索树的中序遍历",
      "params": { "values": [8, 3, 10, 1, 6, 14, 4, 7, 13] }
    },
    {
      "id": "polish-tree-build",
      "algorithm": "bst_build",
      "title": "二叉搜索树构建",
      "params": { "values": [8, 3, 10, 1, 6, 14, 4, 7, 13] }
    },
    {
      "id": "polish-bfs",
      "algorithm": "bfs",
      "title": "BFS 广度优先搜索",
      "params": {
        "nodes": ["A", "B", "C", "D", "E", "F"],
        "edges": [["A", "B"], ["A", "C"], ["B", "D"], ["C", "E"], ["D", "F"], ["E", "F"]],
        "start": "A"
      }
    },
    {
      "id": "polish-knapsack",
      "algorithm": "knapsack_01",
      "title": "0-1 背包：二维动态规划",
      "params": { "weights": [2, 3, 4, 5], "values": [3, 4, 5, 6], "capacity": 8 }
    },
    {
      "id": "polish-lcs",
      "algorithm": "lcs",
      "title": "最长公共子序列 LCS",
      "params": { "s1": "ABCBDAB", "s2": "BDCABA" }
    }
  ]
}
