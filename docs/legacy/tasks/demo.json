{
  "batch_name": "demo_algorithms",
  "defaults": {
    "render_quality": "high",
    "tts": true,
    "theme": "dark",
    "steps_per_segment": 4
  },
  "tasks": [
    {
      "id": "sort-bubble",
      "algorithm": "bubble_sort",
      "title": "冒泡排序：相邻交换",
      "params": { "array": [5, 3, 8, 1, 9, 2] }
    },
    {
      "id": "sort-quick-nl",
      "prompt": "请生成快速排序的教学视频，选择第一个元素作为 Pivot，使用数组 [8, 3, 5, 1, 9, 2]。"
    },
    {
      "id": "sort-merge",
      "algorithm": "merge_sort",
      "title": "归并排序：分治与合并",
      "params": { "array": [8, 3, 5, 1, 9, 2, 7, 4] }
    },
    {
      "id": "search-binary",
      "algorithm": "binary_search",
      "title": "二分查找：每次排除一半",
      "params": { "array": [1, 3, 5, 7, 9, 11, 13], "target": 7 }
    },
    {
      "id": "tree-inorder",
      "algorithm": "tree_inorder",
      "title": "二叉搜索树的中序遍历",
      "params": { "values": [8, 3, 10, 1, 6, 14, 4, 7, 13] }
    },
    {
      "id": "tree-build",
      "algorithm": "bst_build",
      "title": "二叉搜索树构建",
      "params": { "values": [8, 3, 10, 1, 6, 14, 4, 7, 13] }
    },
    {
      "id": "graph-bfs",
      "algorithm": "bfs",
      "title": "BFS 广度优先搜索",
      "params": {
        "nodes": ["A", "B", "C", "D", "E", "F"],
        "edges": [["A", "B"], ["A", "C"], ["B", "D"], ["C", "E"], ["D", "F"], ["E", "F"]],
        "start": "A"
      }
    },
    {
      "id": "graph-dijkstra",
      "algorithm": "dijkstra",
      "title": "Dijkstra 最短路径",
      "params": {
        "nodes": ["A", "B", "C", "D", "E", "F"],
        "edges": [["A", "B", 4], ["A", "C", 2], ["B", "C", 1], ["B", "D", 5], ["C", "D", 8], ["C", "E", 10], ["D", "E", 2], ["D", "F", 6], ["E", "F", 3]],
        "start": "A",
        "target": "F"
      }
    },
    {
      "id": "dp-knapsack",
      "algorithm": "knapsack_01",
      "title": "0-1 背包：二维动态规划",
      "params": { "weights": [2, 3, 4, 5], "values": [3, 4, 5, 6], "capacity": 8 }
    },
    {
      "id": "dp-lcs",
      "algorithm": "lcs",
      "title": "最长公共子序列 LCS",
      "params": { "s1": "ABCBDAB", "s2": "BDCABA" }
    }
  ]
}
